#################################################################
# VCF Core Vocabulary -- external alignments
#
# Generated by scripts/build-mapping-sets.py from
# mappings/vcf-core-alignments.sssom.tsv. Do not edit by hand: curate
# the SSSOM file and rebuild with `npm run mappings:build`.
#
# This module is NOT imported by the core vocabulary. Load it only if
# you want vcf-core's outward alignments; the core stays usable without
# committing to any external model.
#################################################################

@prefix chebi:    <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix faldo:    <http://biohackathon.org/resource/faldo#> .
@prefix geno:     <http://purl.obolibrary.org/obo/GENO_> .
@prefix gfvo:     <https://github.com/BioInterchange/Ontologies/gfvo#> .
@prefix gvo:      <http://genome-variation.org/resource/gvo#> .
@prefix hero:     <https://w3id.org/hereditary/ontology/genomics/schema/> .
@prefix med2rdf:  <http://med2rdf.org/ontology/med2rdf#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semapv:   <https://w3id.org/semapv/vocab/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix so:       <http://purl.obolibrary.org/obo/SO_> .
@prefix sssom:    <https://w3id.org/sssom/> .
@prefix vcfc:     <https://w3id.org/vcf-core/vocab#> .
@prefix vrs:      <https://w3id.org/ga4gh/schema/vrs/2.0/json/> .

<https://w3id.org/vcf-core/alignments> a owl:Ontology ;
  rdfs:label "VCF Core Vocabulary: external alignments"@en ;
  dct:description "The single curated record of every alignment vcf-core asserts against an external vocabulary. This file is the source of truth: vcf-core-alignments.ttl is generated from it by scripts/build-mapping-sets.py. Rows commented 'Also asserted inline in the vcf-core ontology modules' are additionally present in ontology/*.ttl and reach anyone loading the bundle; the rest reach only those who load the alignment module."@en ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  dct:modified "2026-09-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
  owl:versionIRI <https://w3id.org/vcf-core/alignments/2.1.1> ;
  owl:versionInfo "2.1.1" ;
  owl:imports <https://w3id.org/vcf-core/vocab> ;
  dct:source <https://w3id.org/vcf-core/mappings/vcf-core-alignments.sssom.tsv> ;
  rdfs:seeAlso <https://mapping-commons.github.io/sssom/> .

#################################################################
# GA4GH Variation Representation Specification 2.0
#################################################################

vcfc:Allele skos:closeMatch vrs:Allele .
vcfc:AltAllele skos:closeMatch vrs:LiteralSequenceExpression .
vcfc:Breakend skos:relatedMatch vrs:Adjacency ;
  skos:relatedMatch vrs:Terminus .
vcfc:ConfidenceInterval skos:closeMatch vrs:Range .
vcfc:ContigHeaderLine skos:relatedMatch vrs:SequenceReference .
vcfc:PhaseSet skos:closeMatch vrs:CisPhasedBlock .
vcfc:ReferenceAllele skos:closeMatch vrs:LiteralSequenceExpression .
vcfc:SymbolicCopyNumberVariation skos:closeMatch vrs:CopyNumberChange .
vcfc:TandemRepeatAllele skos:closeMatch vrs:ReferenceLengthExpression .
vcfc:VCFRecord skos:relatedMatch vrs:Allele ;
  skos:relatedMatch vrs:SequenceLocation .
vcfc:VariantCall skos:closeMatch vrs:Allele .
vcfc:copyNumber skos:relatedMatch vrs:CopyNumberCount .
vcfc:referenceGenome skos:relatedMatch vrs:SequenceReference .

#################################################################
# HERO, the Hereditary Ontology for Genomics Data
#################################################################

vcfc:FilterStatus skos:relatedMatch hero:VariantQuality .
vcfc:FormatFieldValue skos:relatedMatch hero:Genotype .
vcfc:InfoFieldValue skos:relatedMatch hero:VariantLevelData .
vcfc:SampleCall skos:closeMatch hero:Genotype ;
  skos:relatedMatch hero:Zygosity .
vcfc:VCFFile skos:exactMatch hero:VCFFile .
vcfc:VCFRecord skos:exactMatch hero:VCFRecord .
vcfc:VariantCall skos:closeMatch hero:GenomicVariation .
vcfc:alt skos:exactMatch hero:vcfAlt .
vcfc:chrom skos:exactMatch hero:vcfChrom .
vcfc:filter skos:closeMatch hero:vcfFilter .
vcfc:infoRaw skos:exactMatch hero:vcfInfo .
vcfc:pos skos:exactMatch hero:vcfPos .
vcfc:qual skos:closeMatch hero:variantQuality ;
  skos:exactMatch hero:vcfQual .
vcfc:ref skos:exactMatch hero:vcfRef .
vcfc:referenceGenome skos:closeMatch hero:genomeAssembly .

#################################################################
# GVO, the Genome Variation Ontology
#################################################################

vcfc:Breakend skos:closeMatch gvo:Bnd .
vcfc:EventDeletion skos:exactMatch gvo:Del .
vcfc:EventDuplication skos:exactMatch gvo:Dup .
vcfc:EventInsertion skos:exactMatch gvo:Ins .
vcfc:EventInversion skos:exactMatch gvo:Inv .
vcfc:EventMobileElementDeletion skos:exactMatch gvo:DelME .
vcfc:EventMobileElementInsertion skos:exactMatch gvo:InsME .
vcfc:EventTandemDuplication skos:exactMatch gvo:TDup .
vcfc:EventTranslocation skos:closeMatch gvo:Ctx ;
  skos:narrowMatch gvo:InterCtx ;
  skos:narrowMatch gvo:IntraCtx .
vcfc:SymbolicCopyNumberVariation skos:exactMatch gvo:CNV .
vcfc:SymbolicDeletion skos:exactMatch gvo:Del .
vcfc:SymbolicDuplication skos:exactMatch gvo:Dup .
vcfc:SymbolicInsertion skos:exactMatch gvo:Ins .
vcfc:SymbolicInversion skos:exactMatch gvo:Inv .
vcfc:SymbolicMobileElementDeletion skos:exactMatch gvo:DelME ;
  skos:narrowMatch gvo:DelAlu ;
  skos:narrowMatch gvo:DelHERV ;
  skos:narrowMatch gvo:DelLINE1 ;
  skos:narrowMatch gvo:DelSVA .
vcfc:SymbolicMobileElementInsertion skos:exactMatch gvo:InsME ;
  skos:narrowMatch gvo:InsAlu ;
  skos:narrowMatch gvo:InsHERV ;
  skos:narrowMatch gvo:InsLINE1 ;
  skos:narrowMatch gvo:InsSVA .
vcfc:SymbolicTandemDuplication skos:exactMatch gvo:TDup .
vcfc:SymbolicTandemRepeat skos:closeMatch gvo:STRV ;
  skos:closeMatch gvo:TR .
vcfc:alt skos:closeMatch gvo:alt ;
  skos:exactMatch gvo:alt_vcf .
vcfc:chrom skos:exactMatch gvo:chrom .
vcfc:filter skos:closeMatch gvo:filter .
vcfc:infoRaw skos:closeMatch gvo:info .
vcfc:pos skos:closeMatch gvo:pos ;
  skos:exactMatch gvo:pos_vcf .
vcfc:qual skos:exactMatch gvo:qual .
vcfc:ref skos:closeMatch gvo:ref ;
  skos:exactMatch gvo:ref_vcf .

#################################################################
# GFVO, the Genomic Feature and Variation Ontology
#################################################################

vcfc:Genotype skos:closeMatch gfvo:Genotype .
vcfc:PhasingStatus skos:closeMatch gfvo:GameticPhase .
vcfc:ReservedFormat_DP skos:closeMatch gfvo:Coverage .
vcfc:ReservedFormat_GQ skos:closeMatch gfvo:ConditionalGenotypeQuality .
vcfc:ReservedInfo_AC skos:closeMatch gfvo:AlleleCount .
vcfc:ReservedInfo_AF skos:closeMatch gfvo:AlleleFrequency .
vcfc:ReservedInfo_AN skos:closeMatch gfvo:TotalNumberOfAlleles .
vcfc:ReservedInfo_BQ skos:closeMatch gfvo:BaseQuality .
vcfc:ReservedInfo_DP skos:closeMatch gfvo:Coverage .
vcfc:ReservedInfo_MQ skos:closeMatch gfvo:MappingQuality .
vcfc:ReservedInfo_NS skos:closeMatch gfvo:SampleCount .
vcfc:VCFSample skos:closeMatch gfvo:Sample .
vcfc:VariantCall skos:relatedMatch gfvo:VariantCalling .
vcfc:qual skos:relatedMatch gfvo:PhredScore .

#################################################################
# Med2RDF
#################################################################

vcfc:VariantCall skos:closeMatch med2rdf:Variation .
vcfc:alt skos:exactMatch med2rdf:alternative_allele_vcf .
vcfc:ref skos:exactMatch med2rdf:reference_allele_vcf .

#################################################################
# Sequence Ontology
#################################################################

vcfc:Breakend skos:relatedMatch so:0001021 .
vcfc:EventBalancedTranslocation skos:exactMatch so:1000048 .
vcfc:EventChromothripsis skos:closeMatch so:0002062 .
vcfc:EventDeletion skos:exactMatch so:0000159 .
vcfc:EventDuplication skos:exactMatch so:1000035 .
vcfc:EventInsertion skos:exactMatch so:0000667 .
vcfc:EventInversion skos:exactMatch so:1000036 .
vcfc:EventMobileElementDeletion skos:exactMatch so:0002066 .
vcfc:EventMobileElementInsertion skos:exactMatch so:0001837 .
vcfc:EventTandemDuplication skos:exactMatch so:1000173 .
vcfc:EventTranslocation skos:exactMatch so:0000199 .
vcfc:SymbolicCopyNumberVariation skos:exactMatch so:0001019 .
vcfc:SymbolicDeletion skos:exactMatch so:0000159 .
vcfc:SymbolicDuplication skos:exactMatch so:1000035 .
vcfc:SymbolicInsertion skos:exactMatch so:0000667 .
vcfc:SymbolicInversion skos:exactMatch so:1000036 .
vcfc:SymbolicMobileElementDeletion skos:exactMatch so:0002066 .
vcfc:SymbolicMobileElementInsertion skos:exactMatch so:0001837 .
vcfc:SymbolicTandemDuplication skos:exactMatch so:1000173 .
vcfc:SymbolicTandemRepeat skos:closeMatch so:0000705 ;
  skos:relatedMatch so:0002096 .
vcfc:VariantCall skos:closeMatch so:0001060 .

#################################################################
# GENO, the Genotype Ontology
#################################################################

vcfc:Genotype skos:closeMatch geno:0000536 .
vcfc:PhaseSet skos:closeMatch geno:0000886 .

#################################################################
# ChEBI
#################################################################

vcfc:ReservedFormat_M5caC skos:exactMatch chebi:76793 .
vcfc:ReservedFormat_M5caU skos:exactMatch chebi:17477 .
vcfc:ReservedFormat_M5fC skos:exactMatch chebi:76794 .
vcfc:ReservedFormat_M5fU skos:exactMatch chebi:80961 .
vcfc:ReservedFormat_M5hmC skos:exactMatch chebi:76792 .
vcfc:ReservedFormat_M5hmU skos:exactMatch chebi:16964 .
vcfc:ReservedFormat_M5mC skos:exactMatch chebi:27551 .
vcfc:ReservedFormat_M6mA skos:exactMatch chebi:28871 .
vcfc:ReservedFormat_M8oxoG skos:exactMatch chebi:44605 .
vcfc:ReservedFormat_MXaoN skos:exactMatch chebi:18107 .

#################################################################
# FALDO
#################################################################

vcfc:VCFRecord skos:relatedMatch faldo:Region .

#################################################################
# Per-mapping provenance
#
# Confidence and curation notes, reified so a consumer can filter on
# them without leaving RDF. The SSSOM file carries the same values.
#################################################################

[] a owl:Axiom ;
  owl:annotatedSource vcfc:Allele ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget vrs:Allele ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:AltAllele ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget vrs:LiteralSequenceExpression ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.7 ;
  rdfs:comment "Holds only for explicit base-sequence ALTs, not symbolic or breakend ALTs. VRS 2.0 is the hub every SWAT4HCLS 2025 BioHackathon set was mapped against; this spoke is what makes those sets composable with vcf-core."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:Breakend ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget vrs:Adjacency ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.7 ;
  rdfs:comment "VRS models a join between two sequences; VCF models one side of it per record."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:Breakend ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget vrs:Terminus ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.6 ;
  rdfs:comment "Corresponds to the single-breakend and telomeric cases."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:ConfidenceInterval ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget vrs:Range ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.7 ;
  rdfs:comment "CIPOS/CIEND bounds correspond to a VRS Range."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:ContigHeaderLine ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget vrs:SequenceReference ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:PhaseSet ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget vrs:CisPhasedBlock ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:ReferenceAllele ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget vrs:LiteralSequenceExpression ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.7 ;
  rdfs:comment "REF is a literal sequence; VRS wraps it in a sequence expression. VRS 2.0 is the hub every SWAT4HCLS 2025 BioHackathon set was mapped against; this spoke is what makes those sets composable with vcf-core."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:SymbolicCopyNumberVariation ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget vrs:CopyNumberChange ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.8 .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:TandemRepeatAllele ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget vrs:ReferenceLengthExpression ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.7 .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:VCFRecord ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget vrs:Allele ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:VCFRecord ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget vrs:SequenceLocation ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:VariantCall ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget vrs:Allele ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:copyNumber ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget vrs:CopyNumberCount ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.7 ;
  rdfs:comment "CN carries the count that VRS reifies as a class."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:referenceGenome ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget vrs:SequenceReference ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.7 .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:FilterStatus ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget hero:VariantQuality ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.5 ;
  rdfs:comment "HERO groups quality and filtering; vcf-core separates them."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:FormatFieldValue ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget hero:Genotype ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:InfoFieldValue ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget hero:VariantLevelData ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:SampleCall ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget hero:Genotype ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:SampleCall ;
  owl:annotatedProperty skos:relatedMatch ;
  owl:annotatedTarget hero:Zygosity ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:VCFFile ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget hero:VCFFile ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:VCFRecord ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget hero:VCFRecord ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:VariantCall ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget hero:GenomicVariation ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  rdfs:comment "Also asserted inline in the vcf-core ontology modules."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:alt ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget hero:vcfAlt ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.9 ;
  rdfs:comment "Both are the ALT column as written."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:chrom ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget hero:vcfChrom ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.95 ;
  rdfs:comment "HERO is the only surveyed model with first-class VCF column terms, so these are near one-to-one."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:filter ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget hero:vcfFilter ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.8 ;
  rdfs:comment "vcf-core reifies FILTER codes as resources; HERO keeps the raw token. HERO mapped this to sssom:NoTermFound against VRS."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:infoRaw ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget hero:vcfInfo ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.9 ;
  rdfs:comment "Both are the undecoded INFO string. HERO mapped this to sssom:NoTermFound against VRS."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:pos ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget hero:vcfPos ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.95 ;
  rdfs:comment "Both are the 1-based VCF POS value."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:qual ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget hero:variantQuality ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.7 ;
  rdfs:comment "HERO's property form of the same quantity."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:qual ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget hero:vcfQual ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.95 ;
  rdfs:comment "Phred-scaled QUAL. HERO mapped this to sssom:NoTermFound against VRS."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:ref ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget hero:vcfRef ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.9 ;
  rdfs:comment "Both are the REF column as written, including VCF padding bases."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:referenceGenome ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget hero:genomeAssembly ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.8 .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:Breakend ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget gvo:Bnd ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.8 .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventDeletion ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget gvo:Del ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.85 ;
  rdfs:comment "SVTYPE event counterpart of the symbolic allele type."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventDuplication ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget gvo:Dup ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.85 ;
  rdfs:comment "SVTYPE event counterpart of the symbolic allele type."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventInsertion ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget gvo:Ins ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.85 ;
  rdfs:comment "SVTYPE event counterpart of the symbolic allele type."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventInversion ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget gvo:Inv ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.85 ;
  rdfs:comment "SVTYPE event counterpart of the symbolic allele type."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventMobileElementDeletion ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget gvo:DelME ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.85 ;
  rdfs:comment "SVTYPE event counterpart of the symbolic allele type."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventMobileElementInsertion ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget gvo:InsME ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.85 ;
  rdfs:comment "SVTYPE event counterpart of the symbolic allele type."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventTandemDuplication ;
  owl:annotatedProperty skos:exactMatch ;
  owl:annotatedTarget gvo:TDup ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.85 ;
  rdfs:comment "SVTYPE event counterpart of the symbolic allele type."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventTranslocation ;
  owl:annotatedProperty skos:closeMatch ;
  owl:annotatedTarget gvo:Ctx ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.8 .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventTranslocation ;
  owl:annotatedProperty skos:narrowMatch ;
  owl:annotatedTarget gvo:InterCtx ;
  sssom:mapping_justification semapv:ManualMappingCuration ;
  sssom:confidence 0.8 ;
  rdfs:comment "GVO distinguishes inter- from intrachromosomal; VCF 4.5 does not."@en .

[] a owl:Axiom ;
  owl:annotatedSource vcfc:EventTranslocation ;
  owl:annotatedProperty skos:narrowMatch ;
