PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Preservation only: explicitly decode the documented VCF text encoding.
SELECT (?sample AS ?name) ?value WHERE {
?file vcfc:hasRecord ?record ; vcfc:hasSampleSet/vcfc:hasSample ?s .
  ?record vcfc:pos 10 ; vcfc:hasCall/vcfc:hasCallMatrix ?matrix .
  ?s vcfc:sampleIndex ?sampleIndex ; vcfc:sampleName ?sample .
?matrix vcfc:hasFormatValueVector ?vectorvalue . ?vectorvalue vcfc:declaredBy/vcfc:fieldId "DP" ; vcfc:encodedValues ?packedvalue .

  BIND(CONCAT("^(?:[^\\t]*\\t){", STR(?sampleIndex - 1), "}([^\\t]*).*$") AS ?patternvalue)
  BIND(REPLACE(?packedvalue, ?patternvalue, "$1") AS ?value)
}
