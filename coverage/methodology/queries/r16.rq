PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
# Expected answers are authored in inputs/cases.json from the source VCF.
SELECT ?index ?value ?allele WHERE { ?r vcfc:pos 10 ; vcfc:hasCall/vcfc:hasInfoValue ?v . ?v vcfc:declaredBy/vcfc:fieldId "AF" ; vcfc:hasValueItem ?i . ?i vcfc:valueIndex ?index ; vcfc:itemValue ?value ; vcfc:forAllele/vcfc:alleleValue ?allele }
