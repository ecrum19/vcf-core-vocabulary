PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
# Expected answers are authored in inputs/cases.json from the source VCF.
SELECT ?sample ?i ?phase WHERE { ?r vcfc:pos 10 ; vcfc:hasCall/vcfc:hasSampleCall ?s . ?s vcfc:sampleId ?sample ; vcfc:hasGenotype/vcfc:hasAlleleCall ?a . ?a vcfc:callIndex ?i ; vcfc:phaseIndicator ?phase . FILTER(?i = 1) }
