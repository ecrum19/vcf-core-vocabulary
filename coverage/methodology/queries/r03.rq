PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
# Expected answers are authored in inputs/cases.json from the source VCF.
SELECT ?id ?n ?t ?d ?s ?v WHERE { ?dcl a vcfc:INFOHeaderLine ; vcfc:fieldId ?id ; vcfc:fieldNumber ?n ; vcfc:fieldType ?t ; vcfc:fieldDescription ?d ; vcfc:fieldSource ?s ; vcfc:fieldVersion ?v . FILTER(?id = "AF") }
