PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Preservation only: explicitly decode the documented VCF text encoding.
SELECT ?sample ?index ?missing ?allele WHERE {
?file vcfc:hasRecord ?record ; vcfc:hasSampleSet/vcfc:hasSample ?s .
  ?record vcfc:pos 10 ; vcfc:hasCall/vcfc:hasCallMatrix ?matrix .
  ?s vcfc:sampleIndex ?sampleIndex ; vcfc:sampleName ?sample .
?matrix vcfc:hasFormatValueVector ?vectorraw . ?vectorraw vcfc:declaredBy/vcfc:fieldId "GT" ; vcfc:encodedValues ?packedraw .

  BIND(CONCAT("^(?:[^\\t]*\\t){", STR(?sampleIndex - 1), "}([^\\t]*).*$") AS ?patternraw)
  BIND(REPLACE(?packedraw, ?patternraw, "$1") AS ?raw)

  # Bounded diploid witness; the general arbitrary-ploidy requirement is R37.
  VALUES ?index { 0 1 }
  BIND(REPLACE(?raw, "^[/|]", "") AS ?gt)
  BIND(CONCAT("^(?:[^/|]*[/|]){", STR(?index), "}([^/|]*).*$") AS ?allelePattern)
  BIND(REPLACE(?gt, ?allelePattern, "$1") AS ?token)
  BIND(?token = "." AS ?missing)
  BIND(xsd:integer(?token) AS ?allele)
}
