PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
# Expected answers are authored in inputs/cases.json from the source VCF.
SELECT ?name ?value WHERE { ?r vcfc:pos 10 ; vcfc:hasCall/vcfc:hasSampleCall ?s . ?s vcfc:forSample/vcfc:sampleName ?name ; vcfc:hasFormatValue ?v . ?v vcfc:declaredBy/vcfc:fieldId "DP" ; vcfc:fieldValue ?value }
