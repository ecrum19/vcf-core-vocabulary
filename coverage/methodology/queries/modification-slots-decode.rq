PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
# Preservation only: explicitly decode the documented VCF text encoding.
SELECT ?pos ?key ?genotype ?values WHERE {
  ?file vcfc:hasRecord ?record ; vcfc:hasSampleSet/vcfc:hasSample ?s .
  ?record vcfc:pos ?pos ; vcfc:hasCall/vcfc:hasCallMatrix ?matrix .
  ?s vcfc:sampleIndex ?sampleIndex .
  BIND(CONCAT("^(?:[^\\t]*\\t){", STR(?sampleIndex - 1), "}([^\\t]*).*$") AS ?column)
  ?matrix vcfc:hasFormatValueVector ?genotypeVector .
  ?genotypeVector vcfc:declaredBy/vcfc:fieldId "GT" ; vcfc:encodedValues ?packedGenotype .
  BIND(REPLACE(?packedGenotype, ?column, "$1") AS ?genotype)
  ?matrix vcfc:hasFormatValueVector ?vector .
  ?vector vcfc:declaredBy/vcfc:fieldId ?key ; vcfc:encodedValues ?packed .
  BIND(REPLACE(?packed, ?column, "$1") AS ?values)
  FILTER(?pos < 50 && ?key IN ("M5mC", "M5hmC"))
}
