PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
# Preservation only: explicitly decode the documented VCF text encoding.
SELECT ?pos ?localDepths ?globalDepths WHERE {
  ?file vcfc:hasSampleSet/vcfc:hasSample ?s .
  ?s vcfc:sampleIndex ?sampleIndex .
  BIND(CONCAT("^(?:[^\\t]*\\t){", STR(?sampleIndex - 1), "}([^\\t]*).*$") AS ?column)
  ?file vcfc:hasRecord ?local .
  ?local vcfc:pos ?pos ; vcfc:hasCall/vcfc:hasCallMatrix ?localMatrix .
  ?localMatrix vcfc:hasFormatValueVector ?localVector .
  ?localVector vcfc:declaredBy/vcfc:fieldId "LAD" ; vcfc:encodedValues ?packedLocal .
  BIND(REPLACE(?packedLocal, ?column, "$1") AS ?localDepths)
  ?file vcfc:hasRecord ?global .
  ?global vcfc:pos ?pos ; vcfc:hasCall/vcfc:hasCallMatrix ?globalMatrix .
  ?globalMatrix vcfc:hasFormatValueVector ?globalVector .
  ?globalVector vcfc:declaredBy/vcfc:fieldId "AD" ; vcfc:encodedValues ?packedGlobal .
  BIND(REPLACE(?packedGlobal, ?column, "$1") AS ?globalDepths)
}
