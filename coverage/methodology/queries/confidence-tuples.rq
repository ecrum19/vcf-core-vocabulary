PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>
# Expected answers are authored in inputs/cases.json from the source VCF.
SELECT ?i ?value ?allele WHERE { ?v vcfc:declaredBy/vcfc:fieldId "CIPOS" ; vcfc:hasValueItem ?item . ?item vcfc:valueIndex ?i ; vcfc:itemValue ?value . OPTIONAL { ?item vcfc:forAllele/vcfc:alleleIndex ?allele } }
