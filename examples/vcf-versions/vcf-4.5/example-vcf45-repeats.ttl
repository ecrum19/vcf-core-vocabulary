@prefix ex: <file://example-vcf45-repeats.vcf#> .
@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file://example-vcf45-repeats.vcf> a vcfc:VCF45File,
        vcfc:VCFFile ;
    vcfc:fileFormat "VCFv4.5" ;
    vcfc:hasHeader ex:header ;
    vcfc:hasRecord <file://example-vcf45-repeats.vcf#record/1> ;
    vcfc:hasSampleSet ex:samples ;
    vcfc:referenceGenome "https://example.org/reference.fa" ;
    vcfc:representationProfile vcfc:ExpandedRepresentation ;
    vcfc:sourceSoftware "VCF-Core-synthetic-examples" .

<file://example-vcf45-repeats.vcf#call/1> a vcfc:VariantCall ;
    vcfc:filter "PASS" ;
    vcfc:filterStatus vcfc:FiltersPassed ;
    vcfc:formatRaw "GT:CN" ;
    vcfc:hasFormatKey <file://example-vcf45-repeats.vcf#call/1/formatKey/1>,
        <file://example-vcf45-repeats.vcf#call/1/formatKey/2> ;
    vcfc:hasInfoValue <file://example-vcf45-repeats.vcf#call/1/info/CN>,
        <file://example-vcf45-repeats.vcf#call/1/info/RB>,
        <file://example-vcf45-repeats.vcf#call/1/info/RN>,
        <file://example-vcf45-repeats.vcf#call/1/info/RUC>,
        <file://example-vcf45-repeats.vcf#call/1/info/RUL>,
        <file://example-vcf45-repeats.vcf#call/1/info/RUS>,
        <file://example-vcf45-repeats.vcf#call/1/info/SVCLAIM>,
        <file://example-vcf45-repeats.vcf#call/1/info/SVLEN> ;
    vcfc:hasSampleCall <file://example-vcf45-repeats.vcf#sample/1/S1> ;
    vcfc:infoRaw "SVLEN=30;SVCLAIM=D;RN=1;RUS=CAG;RUL=3;RUC=10;RB=30;CN=2" ;
    vcfc:qual "60"^^vcfc:VCFFloat .

<file://example-vcf45-repeats.vcf#call/1/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-repeats.vcf#header/line/15> ;
    vcfc:fieldIndex 1 .

