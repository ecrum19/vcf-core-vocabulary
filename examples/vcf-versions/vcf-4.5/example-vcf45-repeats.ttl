<file://example-vcf45-repeats.vcf#call/1/info/CN> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example-vcf45-repeats.vcf#header/line/14> ;
    vcfc:fieldIndex 8 ;
    vcfc:fieldValue "2" ;
    vcfc:fieldValueDecimal 2.0 ;
    vcfc:hasValueItem <file://example-vcf45-repeats.vcf#call/1/info/CN/item/0> .

