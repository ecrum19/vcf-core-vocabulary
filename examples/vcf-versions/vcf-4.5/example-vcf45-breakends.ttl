@prefix ex: <file://example-vcf45-breakends.vcf#> .
@prefix faldo: <http://biohackathon.org/resource/faldo#> .
@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file://example-vcf45-breakends.vcf> a vcfc:VCF45File,
        vcfc:VCFFile ;
    vcfc:fileFormat "VCFv4.5" ;
    vcfc:hasHeader ex:header ;
    vcfc:hasRecord <file://example-vcf45-breakends.vcf#record/1>,
        <file://example-vcf45-breakends.vcf#record/2>,
        <file://example-vcf45-breakends.vcf#record/3> ;
    vcfc:hasSampleSet ex:samples ;
    vcfc:referenceGenome "https://example.org/reference.fa" ;
    vcfc:representationProfile vcfc:ExpandedRepresentation ;
    vcfc:sourceSoftware "VCF-Core-synthetic-examples" .

<file://example-vcf45-breakends.vcf#call/1> a vcfc:VariantCall ;
    vcfc:filter "PASS" ;
    vcfc:filterStatus vcfc:FiltersPassed ;
    vcfc:formatRaw "GT" ;
    vcfc:hasFormatKey <file://example-vcf45-breakends.vcf#call/1/formatKey/1> ;
    vcfc:hasInfoValue <file://example-vcf45-breakends.vcf#call/1/info/MATEID> ;
    vcfc:hasSampleCall <file://example-vcf45-breakends.vcf#sample/1/S1> ;
    vcfc:infoRaw "MATEID=bnd2" ;
    vcfc:qual "60"^^vcfc:VCFFloat .

<file://example-vcf45-breakends.vcf#call/1/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-breakends.vcf#header/line/7> ;
    vcfc:fieldIndex 1 .

<file://example-vcf45-breakends.vcf#call/1/info/MATEID> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example-vcf45-breakends.vcf#header/line/6> ;
    vcfc:fieldIndex 1 ;
    vcfc:fieldValue "bnd2" ;
    vcfc:hasValueItem <file://example-vcf45-breakends.vcf#call/1/info/MATEID/item/0> .

<file://example-vcf45-breakends.vcf#call/1/info/MATEID/item/0> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example-vcf45-breakends.vcf#record/1/allele/1> ;
    vcfc:itemValue "bnd2" ;
    vcfc:valueIndex 0 .

<file://example-vcf45-breakends.vcf#call/2> a vcfc:VariantCall ;
    vcfc:filter "PASS" ;
    vcfc:filterStatus vcfc:FiltersPassed ;
    vcfc:formatRaw "GT" ;
    vcfc:hasFormatKey <file://example-vcf45-breakends.vcf#call/2/formatKey/1> ;
    vcfc:hasInfoValue <file://example-vcf45-breakends.vcf#call/2/info/MATEID> ;
    vcfc:hasSampleCall <file://example-vcf45-breakends.vcf#sample/2/S1> ;
    vcfc:infoRaw "MATEID=bnd1" ;
    vcfc:qual "60"^^vcfc:VCFFloat .

<file://example-vcf45-breakends.vcf#call/2/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-breakends.vcf#header/line/7> ;
    vcfc:fieldIndex 1 .

<file://example-vcf45-breakends.vcf#call/2/info/MATEID> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example-vcf45-breakends.vcf#header/line/6> ;
    vcfc:fieldIndex 1 ;
    vcfc:fieldValue "bnd1" ;
    vcfc:hasValueItem <file://example-vcf45-breakends.vcf#call/2/info/MATEID/item/0> .

<file://example-vcf45-breakends.vcf#call/2/info/MATEID/item/0> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example-vcf45-breakends.vcf#record/2/allele/1> ;
    vcfc:itemValue "bnd1" ;
    vcfc:valueIndex 0 .

<file://example-vcf45-breakends.vcf#call/3> a vcfc:VariantCall ;
    vcfc:filter "PASS" ;
    vcfc:filterStatus vcfc:FiltersPassed ;
    vcfc:formatRaw "GT" ;
    vcfc:hasFormatKey <file://example-vcf45-breakends.vcf#call/3/formatKey/1> ;
    vcfc:hasSampleCall <file://example-vcf45-breakends.vcf#sample/3/S1> ;
