<file://example-vcf45-breakends.vcf#record/1> a vcfc:VCFRecord ;
    vcfc:alt "A[chr2:500[" ;
    vcfc:chrom "chr1" ;
    vcfc:chromosome <file://example-vcf45-breakends.vcf#header/line/4> ;
    vcfc:hasAltAllele <file://example-vcf45-breakends.vcf#record/1/allele/1> ;
    vcfc:hasCall <file://example-vcf45-breakends.vcf#call/1> ;
    vcfc:hasIdentifier <file://example-vcf45-breakends.vcf#record/1/id/1> ;
    vcfc:hasPaddingInterpretation <file://example-vcf45-breakends.vcf#record/1/padding> ;
    vcfc:hasReferenceAllele <file://example-vcf45-breakends.vcf#record/1/allele/0> ;
    vcfc:pos 400 ;
    vcfc:recordId "bnd1" ;
    vcfc:recordIndex 1 ;
    vcfc:ref "A" .

<file://example-vcf45-breakends.vcf#record/1/allele/1/remote> a faldo:ExactPosition ;
    faldo:position 500 ;
