    vcfc:identifierValue "bnd1" .

<file://example-vcf45-breakends.vcf#record/1/padding> a vcfc:PaddingInterpretation ;
    vcfc:paddingBaseCount 0 ;
    vcfc:paddingRule vcfc:PaddingNotDetermined .

<file://example-vcf45-breakends.vcf#record/2> a vcfc:VCFRecord ;
