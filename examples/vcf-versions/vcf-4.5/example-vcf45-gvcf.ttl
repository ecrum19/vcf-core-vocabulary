<file://example-vcf45-gvcf.vcf#header/line/8/attribute/4> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 4 ;
    vcfc:attributeKey "Description" ;
    vcfc:attributeValue "Example DP" .

<file://example-vcf45-gvcf.vcf#header/line/9/attribute/1> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 1 ;
    vcfc:attributeKey "ID" ;
    vcfc:attributeValue "PL" .

<file://example-vcf45-gvcf.vcf#header/line/9/attribute/2> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 2 ;
    vcfc:attributeKey "Number" ;
    vcfc:attributeValue "G" .

<file://example-vcf45-gvcf.vcf#header/line/9/attribute/3> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 3 ;
    vcfc:attributeKey "Type" ;
    vcfc:attributeValue "Integer" .

<file://example-vcf45-gvcf.vcf#header/line/9/attribute/4> a vcfc:HeaderAttribute ;
