@prefix ex: <file://example-vcf45-gvcf.vcf#> .
@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file://example-vcf45-gvcf.vcf> a vcfc:VCF45File,
        vcfc:VCFFile ;
    vcfc:fileFormat "VCFv4.5" ;
    vcfc:hasHeader ex:header ;
    vcfc:hasRecord <file://example-vcf45-gvcf.vcf#record/1>,
        <file://example-vcf45-gvcf.vcf#record/2> ;
    vcfc:hasSampleSet ex:samples ;
    vcfc:referenceGenome "https://example.org/reference.fa" ;
    vcfc:representationProfile vcfc:ExpandedRepresentation ;
    vcfc:sourceSoftware "VCF-Core-synthetic-examples" .

<file://example-vcf45-gvcf.vcf#call/1> a vcfc:VariantCall ;
    vcfc:filter "."^^vcfc:Null ;
    vcfc:filterStatus vcfc:FiltersNotApplied ;
    vcfc:formatRaw "GT:DP:PL:LEN" ;
    vcfc:hasFormatKey <file://example-vcf45-gvcf.vcf#call/1/formatKey/1>,
        <file://example-vcf45-gvcf.vcf#call/1/formatKey/2>,
        <file://example-vcf45-gvcf.vcf#call/1/formatKey/3>,
        <file://example-vcf45-gvcf.vcf#call/1/formatKey/4> ;
    vcfc:hasSampleCall <file://example-vcf45-gvcf.vcf#sample/1/S1>,
        <file://example-vcf45-gvcf.vcf#sample/1/S2> ;
    vcfc:infoRaw "." ;
    vcfc:qual "."^^vcfc:Null .

<file://example-vcf45-gvcf.vcf#call/1/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-gvcf.vcf#header/line/7> ;
    vcfc:fieldIndex 1 .

<file://example-vcf45-gvcf.vcf#call/1/formatKey/2> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-gvcf.vcf#header/line/8> ;
    vcfc:fieldIndex 2 .

<file://example-vcf45-gvcf.vcf#call/1/formatKey/3> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-gvcf.vcf#header/line/9> ;
    vcfc:fieldIndex 3 .

<file://example-vcf45-gvcf.vcf#call/1/formatKey/4> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-gvcf.vcf#header/line/10> ;
    vcfc:fieldIndex 4 .

<file://example-vcf45-gvcf.vcf#call/2> a vcfc:VariantCall ;
    vcfc:filter "PASS" ;
    vcfc:filterStatus vcfc:FiltersPassed ;
    vcfc:formatRaw "GT:DP" ;
    vcfc:hasFormatKey <file://example-vcf45-gvcf.vcf#call/2/formatKey/1>,
        <file://example-vcf45-gvcf.vcf#call/2/formatKey/2> ;
    vcfc:hasSampleCall <file://example-vcf45-gvcf.vcf#sample/2/S1>,
        <file://example-vcf45-gvcf.vcf#sample/2/S2> ;
    vcfc:infoRaw "." ;
    vcfc:qual "60"^^vcfc:VCFFloat .

<file://example-vcf45-gvcf.vcf#call/2/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-gvcf.vcf#header/line/7> ;
    vcfc:fieldIndex 1 .

<file://example-vcf45-gvcf.vcf#call/2/formatKey/2> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-gvcf.vcf#header/line/8> ;
    vcfc:fieldIndex 2 .

ex:header a vcfc:VCFHeader ;
    vcfc:hasColumnHeader <file://example-vcf45-gvcf.vcf#header/columns> ;
    vcfc:hasHeaderLine <file://example-vcf45-gvcf.vcf#header/line/1>,
        <file://example-vcf45-gvcf.vcf#header/line/10>,
        <file://example-vcf45-gvcf.vcf#header/line/2>,
        <file://example-vcf45-gvcf.vcf#header/line/3>,
        <file://example-vcf45-gvcf.vcf#header/line/4>,
        <file://example-vcf45-gvcf.vcf#header/line/5>,
        <file://example-vcf45-gvcf.vcf#header/line/6>,
        <file://example-vcf45-gvcf.vcf#header/line/7>,
        <file://example-vcf45-gvcf.vcf#header/line/8>,
        <file://example-vcf45-gvcf.vcf#header/line/9> .

<file://example-vcf45-gvcf.vcf#header/columns> a vcfc:ColumnHeaderLine ;
    vcfc:hasGenotypeColumns <file://example-vcf45-gvcf.vcf#samples/S1>,
        <file://example-vcf45-gvcf.vcf#samples/S2> .

<file://example-vcf45-gvcf.vcf#header/line/1> a vcfc:FileFormatHeaderLine ;
    vcfc:headerKey "fileformat" ;
    vcfc:headerValue "VCFv4.5" ;
    vcfc:lineIndex 1 .

<file://example-vcf45-gvcf.vcf#header/line/10/attribute/1> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 1 ;
    vcfc:attributeKey "ID" ;
    vcfc:attributeValue "LEN" .

<file://example-vcf45-gvcf.vcf#header/line/10/attribute/2> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 2 ;
    vcfc:attributeKey "Number" ;
    vcfc:attributeValue "1" .

<file://example-vcf45-gvcf.vcf#header/line/10/attribute/3> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 3 ;
    vcfc:attributeKey "Type" ;
    vcfc:attributeValue "Integer" .

<file://example-vcf45-gvcf.vcf#header/line/10/attribute/4> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 4 ;
    vcfc:attributeKey "Description" ;
    vcfc:attributeValue "Example LEN" .

<file://example-vcf45-gvcf.vcf#header/line/2> a vcfc:SourceHeaderLine ;
    vcfc:headerKey "source" ;
    vcfc:headerValue "VCF-Core-synthetic-examples" ;
    vcfc:lineIndex 2 .

<file://example-vcf45-gvcf.vcf#header/line/3> a vcfc:ReferenceHeaderLine ;
    vcfc:headerKey "reference" ;
    vcfc:headerValue "https://example.org/reference.fa" ;
    vcfc:lineIndex 3 .

<file://example-vcf45-gvcf.vcf#header/line/4/attribute/1> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 1 ;
    vcfc:attributeKey "ID" ;
    vcfc:attributeValue "chr1" .

<file://example-vcf45-gvcf.vcf#header/line/4/attribute/2> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 2 ;
    vcfc:attributeKey "length" ;
    vcfc:attributeValue "1000" .

<file://example-vcf45-gvcf.vcf#header/line/5> a vcfc:ContigHeaderLine ;
    vcfc:contigId "chr2" ;
    vcfc:contigLength 1000 ;
    vcfc:hasAttribute <file://example-vcf45-gvcf.vcf#header/line/5/attribute/1>,
        <file://example-vcf45-gvcf.vcf#header/line/5/attribute/2> ;
    vcfc:headerKey "contig" ;
    vcfc:headerValue "<ID=chr2,length=1000>" ;
    vcfc:lineIndex 5 .

<file://example-vcf45-gvcf.vcf#header/line/5/attribute/1> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 1 ;
    vcfc:attributeKey "ID" ;
    vcfc:attributeValue "chr2" .

<file://example-vcf45-gvcf.vcf#header/line/5/attribute/2> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 2 ;
    vcfc:attributeKey "length" ;
    vcfc:attributeValue "1000" .

<file://example-vcf45-gvcf.vcf#header/line/6/attribute/1> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 1 ;
    vcfc:attributeKey "ID" ;
    vcfc:attributeValue "*" .

<file://example-vcf45-gvcf.vcf#header/line/6/attribute/2> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 2 ;
    vcfc:attributeKey "Description" ;
    vcfc:attributeValue "Synthetic * allele" .

<file://example-vcf45-gvcf.vcf#header/line/7/attribute/1> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 1 ;
    vcfc:attributeKey "ID" ;
    vcfc:attributeValue "GT" .

<file://example-vcf45-gvcf.vcf#header/line/7/attribute/2> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 2 ;
    vcfc:attributeKey "Number" ;
    vcfc:attributeValue "1" .

<file://example-vcf45-gvcf.vcf#header/line/7/attribute/3> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 3 ;
    vcfc:attributeKey "Type" ;
    vcfc:attributeValue "String" .

<file://example-vcf45-gvcf.vcf#header/line/7/attribute/4> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 4 ;
    vcfc:attributeKey "Description" ;
    vcfc:attributeValue "Example GT" .

<file://example-vcf45-gvcf.vcf#header/line/8/attribute/1> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 1 ;
    vcfc:attributeKey "ID" ;
    vcfc:attributeValue "DP" .

<file://example-vcf45-gvcf.vcf#header/line/8/attribute/2> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 2 ;
    vcfc:attributeKey "Number" ;
    vcfc:attributeValue "1" .

<file://example-vcf45-gvcf.vcf#header/line/8/attribute/3> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 3 ;
    vcfc:attributeKey "Type" ;
