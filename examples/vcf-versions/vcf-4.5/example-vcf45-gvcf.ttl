    vcfc:attributeKey "Description" ;
    vcfc:attributeValue "Example PL" .

<file://example-vcf45-gvcf.vcf#record/1> a vcfc:VCFRecord ;
    vcfc:alt "<*>" ;
    vcfc:chrom "chr1" ;
    vcfc:chromosome <file://example-vcf45-gvcf.vcf#header/line/4> ;
    vcfc:hasAltAllele <file://example-vcf45-gvcf.vcf#record/1/allele/1> ;
    vcfc:hasCall <file://example-vcf45-gvcf.vcf#call/1> ;
    vcfc:hasPaddingInterpretation <file://example-vcf45-gvcf.vcf#record/1/padding> ;
    vcfc:hasReferenceAllele <file://example-vcf45-gvcf.vcf#record/1/allele/0> ;
    vcfc:pos 700 ;
    vcfc:recordId "."^^vcfc:Null ;
    vcfc:recordIndex 1 ;
    vcfc:ref "C" .

<file://example-vcf45-gvcf.vcf#record/1/padding> a vcfc:PaddingInterpretation ;
    vcfc:paddingBaseCount 0 ;
    vcfc:paddingRule vcfc:UnspecifiedAlleleNoPadding .

<file://example-vcf45-gvcf.vcf#record/2> a vcfc:VCFRecord ;
    vcfc:alt "."^^vcfc:Null ;
    vcfc:chrom "chr1" ;
    vcfc:chromosome <file://example-vcf45-gvcf.vcf#header/line/4> ;
    vcfc:hasCall <file://example-vcf45-gvcf.vcf#call/2> ;
    vcfc:hasPaddingInterpretation <file://example-vcf45-gvcf.vcf#record/2/padding> ;
    vcfc:hasReferenceAllele <file://example-vcf45-gvcf.vcf#record/2/allele/0> ;
    vcfc:pos 720 ;
    vcfc:recordId "."^^vcfc:Null ;
    vcfc:recordIndex 2 ;
    vcfc:ref "A" .

<file://example-vcf45-gvcf.vcf#record/2/padding> a vcfc:PaddingInterpretation ;
    vcfc:paddingBaseCount 0 ;
    vcfc:paddingRule vcfc:PaddingNotDetermined .

<file://example-vcf45-gvcf.vcf#sample/1/S1> a vcfc:SampleCall ;
    vcfc:forSample <file://example-vcf45-gvcf.vcf#samples/S1> ;
    vcfc:hasFormatValue <file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/DP>,
        <file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/GT>,
        <file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/LEN>,
