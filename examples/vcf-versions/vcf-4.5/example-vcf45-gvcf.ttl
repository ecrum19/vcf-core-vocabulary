    vcfc:fieldIndex 4 ;
    vcfc:fieldValue "5" ;
    vcfc:fieldValueInteger 5 ;
    vcfc:hasValueItem <file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/LEN/item/0> .

<file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/LEN/item/0> a vcfc:FieldValueItem ;
    vcfc:itemValue 5 ;
    vcfc:valueIndex 0 .

<file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/PL> a vcfc:FormatFieldValue ;
