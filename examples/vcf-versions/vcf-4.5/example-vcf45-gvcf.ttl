    vcfc:fieldIndex 3 ;
    vcfc:fieldValue "0,30,90" ;
    vcfc:hasValueItem <file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/PL/item/0>,
        <file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/PL/item/1>,
