    vcfc:hasGenotype <file://example-vcf45-gvcf.vcf#sample/1/S1/genotype> ;
    vcfc:hasReferenceBlock <file://example-vcf45-gvcf.vcf#sample/1/S1/block> ;
    vcfc:sampleFieldsRaw "0/0:20:0,30,90:5" ;
    vcfc:sampleId "S1" .

<file://example-vcf45-gvcf.vcf#sample/1/S1/block> a vcfc:ReferenceBlock ;
    vcfc:blockAllele <file://example-vcf45-gvcf.vcf#record/1/allele/1> ;
    vcfc:endPosition 704 ;
    vcfc:isReferenceBlockStart true ;
    vcfc:referenceBlockLength 5 .

<file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/DP> a vcfc:FormatFieldValue ;
    vcfc:declaredBy <file://example-vcf45-gvcf.vcf#header/line/8> ;
    vcfc:fieldIndex 2 ;
    vcfc:fieldValue "20" ;
    vcfc:fieldValueInteger 20 ;
    vcfc:hasValueItem <file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/DP/item/0> .

<file://example-vcf45-gvcf.vcf#sample/1/S1/fmt/DP/item/0> a vcfc:FieldValueItem ;
