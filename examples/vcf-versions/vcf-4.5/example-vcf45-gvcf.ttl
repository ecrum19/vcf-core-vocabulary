<file://example-vcf45-gvcf.vcf#header/line/6> a vcfc:ALTHeaderLine ;
    vcfc:altId "*" ;
    vcfc:fieldDescription "Synthetic * allele" ;
    vcfc:hasAttribute <file://example-vcf45-gvcf.vcf#header/line/6/attribute/1>,
        <file://example-vcf45-gvcf.vcf#header/line/6/attribute/2> ;
    vcfc:headerKey "ALT" ;
    vcfc:headerValue "<ID=*,Description=\"Synthetic * allele\">" ;
    vcfc:lineIndex 6 .

<file://example-vcf45-gvcf.vcf#header/line/4> a vcfc:ContigHeaderLine ;
    vcfc:contigId "chr1" ;
    vcfc:contigLength 1000 ;
    vcfc:hasAttribute <file://example-vcf45-gvcf.vcf#header/line/4/attribute/1>,
        <file://example-vcf45-gvcf.vcf#header/line/4/attribute/2> ;
