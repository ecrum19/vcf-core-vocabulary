<file://example-vcf45-features.vcf#call/2/info/AF> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/14> ;
    vcfc:fieldIndex 1 ;
    vcfc:fieldValue "0.2,0.3" ;
    vcfc:hasValueItem <file://example-vcf45-features.vcf#call/2/info/AF/item/0>,
        <file://example-vcf45-features.vcf#call/2/info/AF/item/1> .

<file://example-vcf45-features.vcf#call/2/info/AF/item/0> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example-vcf45-features.vcf#record/2/allele/1> ;
    vcfc:itemValue "0.2"^^vcfc:VCFFloat ;
    vcfc:valueIndex 0 .

<file://example-vcf45-features.vcf#call/2/info/AF/item/1> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example-vcf45-features.vcf#record/2/allele/2> ;
    vcfc:itemValue "0.3"^^vcfc:VCFFloat ;
    vcfc:valueIndex 1 .

<file://example-vcf45-features.vcf#call/3> a vcfc:VariantCall ;
    vcfc:filter "PASS" ;
    vcfc:filterStatus vcfc:FiltersPassed ;
    vcfc:formatRaw "GT" ;
    vcfc:hasFormatKey <file://example-vcf45-features.vcf#call/3/formatKey/1> ;
    vcfc:hasInfoValue <file://example-vcf45-features.vcf#call/3/info/CILEN>,
        <file://example-vcf45-features.vcf#call/3/info/SVCLAIM>,
        <file://example-vcf45-features.vcf#call/3/info/SVLEN> ;
    vcfc:hasSampleCall <file://example-vcf45-features.vcf#sample/3/S1> ;
    vcfc:infoRaw "SVLEN=20;SVCLAIM=DJ;CILEN=15,25" ;
    vcfc:qual "45"^^vcfc:VCFFloat .

<file://example-vcf45-features.vcf#call/3/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/18> ;
    vcfc:fieldIndex 1 .

<file://example-vcf45-features.vcf#call/3/info/CILEN> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/17> ;
    vcfc:fieldIndex 3 ;
    vcfc:fieldValue "15,25" ;
    vcfc:hasValueItem <file://example-vcf45-features.vcf#call/3/info/CILEN/item/0>,
        <file://example-vcf45-features.vcf#call/3/info/CILEN/item/1> .

<file://example-vcf45-features.vcf#call/3/info/CILEN/item/0> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example-vcf45-features.vcf#record/3/allele/1> ;
    vcfc:itemValue 15 ;
    vcfc:tupleArity 2 ;
    vcfc:valueIndex 0 .

<file://example-vcf45-features.vcf#call/3/info/CILEN/item/1> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example-vcf45-features.vcf#record/3/allele/1> ;
    vcfc:itemValue 25 ;
    vcfc:tupleArity 2 ;
    vcfc:valueIndex 1 .

<file://example-vcf45-features.vcf#call/3/info/SVCLAIM> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/16> ;
    vcfc:fieldIndex 2 ;
    vcfc:fieldValue "DJ" ;
    vcfc:hasValueItem <file://example-vcf45-features.vcf#call/3/info/SVCLAIM/item/0> .

<file://example-vcf45-features.vcf#call/3/info/SVCLAIM/item/0> a vcfc:FieldValueItem ;
