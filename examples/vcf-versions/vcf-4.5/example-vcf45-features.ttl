@prefix chebi: <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix ex: <file://example-vcf45-features.vcf#> .
@prefix faldo: <http://biohackathon.org/resource/faldo#> .
@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file://example-vcf45-features.vcf> a vcfc:VCF45File,
        vcfc:VCFFile ;
    vcfc:fileFormat "VCFv4.5" ;
    vcfc:hasHeader ex:header ;
    vcfc:hasRecord <file://example-vcf45-features.vcf#record/1>,
        <file://example-vcf45-features.vcf#record/2>,
        <file://example-vcf45-features.vcf#record/3> ;
    vcfc:hasSampleSet ex:samples ;
    vcfc:referenceGenome "https://example.org/reference.fa" ;
    vcfc:representationProfile vcfc:ExpandedRepresentation ;
    vcfc:sourceSoftware "VCF-Core-synthetic-examples" .

<file://example-vcf45-features.vcf#call/1> a vcfc:VariantCall ;
    vcfc:filter "PASS" ;
    vcfc:filterStatus vcfc:FiltersPassed ;
    vcfc:formatRaw "GT:DP:AD:PL:M5mC:DPM5mC:ADM5mC" ;
    vcfc:hasFormatKey <file://example-vcf45-features.vcf#call/1/formatKey/1>,
        <file://example-vcf45-features.vcf#call/1/formatKey/2>,
        <file://example-vcf45-features.vcf#call/1/formatKey/3>,
        <file://example-vcf45-features.vcf#call/1/formatKey/4>,
        <file://example-vcf45-features.vcf#call/1/formatKey/5>,
        <file://example-vcf45-features.vcf#call/1/formatKey/6>,
        <file://example-vcf45-features.vcf#call/1/formatKey/7> ;
    vcfc:hasInfoValue <file://example-vcf45-features.vcf#call/1/info/AF> ;
    vcfc:hasSampleCall <file://example-vcf45-features.vcf#sample/1/S1> ;
    vcfc:infoRaw "AF=0.25" ;
    vcfc:qual "60"^^vcfc:VCFFloat .

<file://example-vcf45-features.vcf#call/1/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/18> ;
    vcfc:fieldIndex 1 .

<file://example-vcf45-features.vcf#call/1/formatKey/2> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/19> ;
    vcfc:fieldIndex 2 .

<file://example-vcf45-features.vcf#call/1/formatKey/3> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/20> ;
    vcfc:fieldIndex 3 .

<file://example-vcf45-features.vcf#call/1/formatKey/4> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/21> ;
    vcfc:fieldIndex 4 .

<file://example-vcf45-features.vcf#call/1/formatKey/5> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/22> ;
    vcfc:fieldIndex 5 .

<file://example-vcf45-features.vcf#call/1/formatKey/6> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/23> ;
    vcfc:fieldIndex 6 .

<file://example-vcf45-features.vcf#call/1/formatKey/7> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/24> ;
    vcfc:fieldIndex 7 .

<file://example-vcf45-features.vcf#call/1/info/AF> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/14> ;
    vcfc:fieldIndex 1 ;
    vcfc:fieldValue "0.25" ;
    vcfc:fieldValueDecimal 0.25 ;
    vcfc:hasValueItem <file://example-vcf45-features.vcf#call/1/info/AF/item/0> .

<file://example-vcf45-features.vcf#call/1/info/AF/item/0> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example-vcf45-features.vcf#record/1/allele/1> ;
    vcfc:itemValue "0.25"^^vcfc:VCFFloat ;
    vcfc:valueIndex 0 .

<file://example-vcf45-features.vcf#call/2> a vcfc:VariantCall ;
    vcfc:filter "q10" ;
    vcfc:filterStatus vcfc:FiltersFailed ;
    vcfc:formatRaw "GT:LAA:LAD:LPL:PSL:FT" ;
    vcfc:hasFilterCode <file://example-vcf45-features.vcf#call/2/filter/1> ;
    vcfc:hasFormatKey <file://example-vcf45-features.vcf#call/2/formatKey/1>,
        <file://example-vcf45-features.vcf#call/2/formatKey/2>,
        <file://example-vcf45-features.vcf#call/2/formatKey/3>,
        <file://example-vcf45-features.vcf#call/2/formatKey/4>,
        <file://example-vcf45-features.vcf#call/2/formatKey/5>,
        <file://example-vcf45-features.vcf#call/2/formatKey/6> ;
    vcfc:hasInfoValue <file://example-vcf45-features.vcf#call/2/info/AF> ;
    vcfc:hasSampleCall <file://example-vcf45-features.vcf#sample/2/S1> ;
    vcfc:infoRaw "AF=0.2,0.3" ;
    vcfc:qual "50"^^vcfc:VCFFloat .

<file://example-vcf45-features.vcf#call/2/filter/1> a vcfc:FilterCode ;
    vcfc:componentIndex 1 ;
    vcfc:declaredByFilter <file://example-vcf45-features.vcf#header/line/6> ;
    vcfc:filterCodeValue "q10" .

<file://example-vcf45-features.vcf#call/2/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/18> ;
    vcfc:fieldIndex 1 .

<file://example-vcf45-features.vcf#call/2/formatKey/2> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/25> ;
    vcfc:fieldIndex 2 .

<file://example-vcf45-features.vcf#call/2/formatKey/3> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/26> ;
    vcfc:fieldIndex 3 .

<file://example-vcf45-features.vcf#call/2/formatKey/4> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example-vcf45-features.vcf#header/line/27> ;
    vcfc:fieldIndex 4 .

<file://example-vcf45-features.vcf#call/2/formatKey/5> a vcfc:FormatKey ;
