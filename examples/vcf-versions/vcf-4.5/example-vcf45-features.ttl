<file://example-vcf45-features.vcf#header/line/1> a vcfc:FileFormatHeaderLine ;
    vcfc:headerKey "fileformat" ;
    vcfc:headerValue "VCFv4.5" ;
    vcfc:lineIndex 1 .

<file://example-vcf45-features.vcf#header/line/10> a vcfc:SampleHeaderLine ;
    vcfc:declaresSample <file://example-vcf45-features.vcf#declaration/Original> ;
    vcfc:hasAttribute <file://example-vcf45-features.vcf#header/line/10/attribute/1>,
        <file://example-vcf45-features.vcf#header/line/10/attribute/2> ;
    vcfc:headerKey "SAMPLE" ;
    vcfc:headerValue "<ID=Original,Tissue=Blood>" ;
    vcfc:lineIndex 10 .

<file://example-vcf45-features.vcf#header/line/10/attribute/1> a vcfc:HeaderAttribute ;
    vcfc:attributeIndex 1 ;
    vcfc:attributeKey "ID" ;
    vcfc:attributeValue "Original" .

<file://example-vcf45-features.vcf#header/line/10/attribute/2> a vcfc:HeaderAttribute ;
