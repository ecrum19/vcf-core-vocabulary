    vcfc:fieldIndex 1 ;
    vcfc:fieldValue "20" ;
    vcfc:fieldValueInteger 20 ;
    vcfc:hasValueItem <file://example-vcf45-features.vcf#call/3/info/SVLEN/item/0> .

<file://example-vcf45-features.vcf#call/3/info/SVLEN/item/0> a vcfc:FieldValueItem ;
