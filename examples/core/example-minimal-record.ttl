        <file://example-file1.vcf#header/line/7/attribute/2>,
        <file://example-file1.vcf#header/line/7/attribute/3>,
        <file://example-file1.vcf#header/line/7/attribute/4> ;
    vcfc:headerKey "FORMAT" ;
    vcfc:headerValue "<ID=AD,Number=R,Type=Integer,Description=\"Allelic depths for the ref and alt alleles in the order listed\">" ;
    vcfc:lineIndex 7 .

<file://example-file1.vcf#header/line/8> a vcfc:FORMATHeaderLine ;
    vcfc:fieldDescription "Approximate read depth (reads with MQ=255 or with bad mates are filtered)" ;
    vcfc:fieldId "DP" ;
