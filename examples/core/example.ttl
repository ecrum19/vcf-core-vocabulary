@prefix ex: <file://example.vcf#> .
@prefix vcfc: <https://w3id.org/vcf-core/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file://example.vcf> a vcfc:VCF42File,
        vcfc:VCFFile ;
    vcfc:fileFormat "VCFv4.2" ;
    vcfc:hasHeader ex:header ;
    vcfc:hasRecord <file://example.vcf#record/1>,
        <file://example.vcf#record/2>,
        <file://example.vcf#record/3> ;
    vcfc:hasSampleSet ex:samples ;
    vcfc:referenceGenome "GRCh38" ;
    vcfc:representationProfile vcfc:ExpandedRepresentation ;
    vcfc:sourceSoftware "HaplotypeCaller" .

<file://example.vcf#call/1> a vcfc:VariantCall ;
    vcfc:filter "PASS" ;
    vcfc:filterStatus vcfc:FiltersPassed ;
    vcfc:formatRaw "GT:AD:DP:GQ:PL" ;
    vcfc:hasFormatKey <file://example.vcf#call/1/formatKey/1>,
        <file://example.vcf#call/1/formatKey/2>,
        <file://example.vcf#call/1/formatKey/3>,
        <file://example.vcf#call/1/formatKey/4>,
        <file://example.vcf#call/1/formatKey/5> ;
    vcfc:hasInfoValue <file://example.vcf#call/1/info/AC>,
        <file://example.vcf#call/1/info/AF>,
        <file://example.vcf#call/1/info/AN>,
        <file://example.vcf#call/1/info/DP> ;
    vcfc:hasSampleCall <file://example.vcf#sample/1/NG131FQA1I> ;
    vcfc:infoRaw "AC=1;AF=0.500;AN=2;DP=7" ;
    vcfc:qual "84.77"^^vcfc:VCFFloat .

<file://example.vcf#call/1/formatKey/1> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example.vcf#header/line/10> ;
    vcfc:fieldIndex 1 .

<file://example.vcf#call/1/formatKey/2> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example.vcf#header/line/11> ;
    vcfc:fieldIndex 2 .

<file://example.vcf#call/1/formatKey/3> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example.vcf#header/line/12> ;
    vcfc:fieldIndex 3 .

<file://example.vcf#call/1/formatKey/4> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example.vcf#header/line/13> ;
    vcfc:fieldIndex 4 .

<file://example.vcf#call/1/formatKey/5> a vcfc:FormatKey ;
    vcfc:declaredBy <file://example.vcf#header/line/14> ;
    vcfc:fieldIndex 5 .

<file://example.vcf#call/1/info/AC> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example.vcf#header/line/6> ;
    vcfc:fieldIndex 1 ;
    vcfc:fieldValue "1" ;
    vcfc:fieldValueInteger 1 ;
    vcfc:hasValueItem <file://example.vcf#call/1/info/AC/item/0> .

<file://example.vcf#call/1/info/AC/item/0> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example.vcf#record/1/allele/1> ;
    vcfc:itemValue 1 ;
    vcfc:valueIndex 0 .

<file://example.vcf#call/1/info/AF> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example.vcf#header/line/7> ;
    vcfc:fieldIndex 2 ;
    vcfc:fieldValue "0.500" ;
    vcfc:fieldValueDecimal 0.500 ;
    vcfc:hasValueItem <file://example.vcf#call/1/info/AF/item/0> .

<file://example.vcf#call/1/info/AF/item/0> a vcfc:FieldValueItem ;
    vcfc:forAllele <file://example.vcf#record/1/allele/1> ;
    vcfc:itemValue "0.500"^^vcfc:VCFFloat ;
    vcfc:valueIndex 0 .

<file://example.vcf#call/1/info/AN> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example.vcf#header/line/8> ;
    vcfc:fieldIndex 3 ;
    vcfc:fieldValue "2" ;
    vcfc:fieldValueInteger 2 ;
    vcfc:hasValueItem <file://example.vcf#call/1/info/AN/item/0> .

<file://example.vcf#call/1/info/AN/item/0> a vcfc:FieldValueItem ;
    vcfc:itemValue 2 ;
    vcfc:valueIndex 0 .

<file://example.vcf#call/1/info/DP> a vcfc:InfoFieldValue ;
    vcfc:declaredBy <file://example.vcf#header/line/9> ;
    vcfc:fieldIndex 4 ;
    vcfc:fieldValue "7" ;
    vcfc:fieldValueInteger 7 ;
